      *                                                                 00500019
           Move  R7919010-In-Dato        In    R7919010-Dato-Pluss-Dager00510019
                                         To    W9010-Split-Dato         00520019
      *                                                                 00530019
           If  R7919010-In-Adder-Aar     In    R7919010-Dato-Pluss-Dager00540019
                                         Not = +0                       00550019
           or  R7919010-In-Adder-Mnd     In    R7919010-Dato-Pluss-Dager00560019
                                         Not = +0                       00570019
               Perform F7919010-D000-Adder-Aar-Mnd                      00580019
               If  R7919999-Retur-Abend                                 00590019
                   Move  'C005'          To    R7919999-Paragraf        00600019
                   Perform F7919010-Z900-Abend                          00610019
                   Go To F7919010-C099-Exit                             00620019
               End-If                                                   00630019
           End-If                                                       00640019
      *                                                                 00650019
           If  R7919010-In-Adder-Dag     In    R7919010-Dato-Pluss-Dager00660019
                                         Not = +0                       00670019
               If  R7919010-In-360-Dgr-Pr-Aar                           00680019
                                         In    R7919010-Dato-Pluss-Dager00690019
                   Perform F7919010-F000-Adder-Dag-360                  00700019
               Else                                                     00710019
                   Perform F7919010-E000-Adder-Dag                      00720019
               End-If                                                   00730019
               If  R7919999-Retur-Abend                                 00740019
                   Move  'C003'          To    R7919999-Paragraf        00750019
                   Perform F7919010-Z900-Abend                          00760019
                   Go To F7919010-C099-Exit                             00770019
               End-If                                                   00780019
           End-If                                                       00790019
      *                                                                 00800019
      * Nå skulle datoen være klar.                                     00810019
      *                                                                 00820019
           Move  W9010-Split-Dato        To    R7919010-Ut-Dato         00830019
                                         In    R7919010-Dato-Pluss-Dager00840019
