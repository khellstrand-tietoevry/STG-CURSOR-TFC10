      *################################################################*08050038
       G000-Bank-Dag                     Section.                       08060038
      *                                                                 08070038
           Evaluate True                                                08080038
             When W-Ukedag               =     +7                       08090038
               Set  SW-Ikke-Bank-Dag     To    True                     08100038
      *                                                                 08110038
             When W-Ukedag               =     +6                       08120038
               Set  SW-Ikke-Bank-Dag     To    True                     08130038
      *                                                                 08140038
             When SW-Fridag                                             08150038
               Set  SW-Ikke-Bank-Dag     To    True                     08160038
      *                                                                 08170038
             When Other                                                 08180038
               Set  SW-Bank-Dag          To    True                     08190038
      *                                                                 08200038
           End-Evaluate                                                 08210038
      *                                                                 08220038
           .                                                            08230038
       G099-Exit.                                                       08240038
           Exit.                                                        08250038
      *################################################################*08260038
       H000-1ste-Paaskedag               Section.                       08270038
      *                                                                 08280038
      * Formel utviklet av Lilius/Clavius i det 16de århundre!          08290038
      *                                                                 08300038
           Move  W-Dato                  To    W-Split-Dato-8           08310038
           Move  W-SD8-Aar               To    W-K1P-T                  08320038
      *                                                                 08330038
           Compute  W-K1P-Temp                                          08340038
               =    W-K1P-T / 19                                        08350038
           Move  W-K1P-Temp              To    W-K1P-G-I                08360038
           Compute  W-K1P-Temp                                          08370038
               =    ( ( ( W-K1P-T / 19 ) - W-K1P-G-I ) * 19 + 1,5 )     08380038
           Move  W-K1P-Temp              To    W-K1P-G                  08390038
      *                                                                 08400038
           Compute  W-K1P-Temp                                          08410038
               =    W-K1P-T / 100 + 1                                   08420038
           Move  W-K1P-Temp              To    W-K1P-C                  08430038
      *                                                                 08440038
           Compute  W-K1P-Temp                                          08450038
               =    ( 3 * W-K1P-C ) / 4 - 12                            08460038
           Move  W-K1P-Temp              To    W-K1P-X                  08470038
      *                                                                 08480038
           Compute  W-K1P-Temp                                          08490038
               =    ( 8 * W-K1P-C + 5 ) / 25 - 5                        08500038
           Move  W-K1P-Temp              To    W-K1P-Z                  08510038
      *                                                                 08520038
           Compute  W-K1P-Temp                                          08530038
               =    ( 5 * W-K1P-T ) / 4 - W-K1P-X - 10                  08540038
           Move  W-K1P-Temp              To    W-K1P-D                  08550038
      *                                                                 08560038
           Compute  W-K1P-Temp                                          08570038
               =    ( 11 * W-K1P-G + 20 + W-K1P-Z - W-K1P-X ) / 30      08580038
           Move  W-K1P-Temp              To    W-K1P-E-I                08590038
           Compute  W-K1P-Temp                                          08600038
               =    ( ( ( 11 * W-K1P-G + 20 + W-K1P-Z - W-K1P-X )       08610038
                        / 30 - W-K1P-E-I )                              08620038
                      * 30 + 0,5 )                                      08630038
           Move  W-K1P-Temp              To    W-K1P-E                  08640038
      *                                                                 08650038
           Evaluate True                                                08660038
             When W-K1P-E                =     25                       08670038
             and  W-K1P-G                >     11                       08680038
               Add   +1                  To    W-K1P-E                  08690038
             When W-K1P-E                =     24                       08700038
               Add   +1                  To    W-K1P-E                  08710038
           End-Evaluate                                                 08720038
      *                                                                 08730038
           Compute  W-K1P-N                                             08740038
               =    44 - W-K1P-E                                        08750038
      *                                                                 08760038
           If  W-K1P-N                   <     21                       08770038
               Add   +30                 To    W-K1P-N                  08780038
           End-If                                                       08790038
      *                                                                 08800038
           Compute  W-K1P-Temp                                          08810038
               =    ( W-K1P-D + W-K1P-N ) / 7                           08820038
           Move  W-K1P-Temp              To    W-K1P-Y-I                08830038
           Compute  W-K1P-Temp                                          08840038
               =    ( ( ( W-K1P-D + W-K1P-N ) / 7 - W-K1P-Y-I )         08850038
                      * 7 + 0,5 )                                       08860038
           Move  W-K1P-Temp              To    W-K1P-Y                  08870038
      *                                                                 08880038
           Compute  W-K1P-N                                             08890038
               =    W-K1P-N + 7 - W-K1P-Y                               08900038
      *                                                                 08910038
           If  W-K1P-N                   >     31                       08920038
               Subtract 31               From  W-K1P-N                  08930038
               Move  04                  To    W-K1P-M                  08940038
           Else                                                         08950038
