           If  Not R7919999-Retur-OK                                    05860038
               Move  'F002'              To    R7919999-Paragraf        05870038
               Perform Z900-Abend                                       05880038
           End-If                                                       05890038
      *                                                                 05900038
           Perform Varying Ind-Spes                                     05910038
                   From +1                                              05920038
                   By   +1                                              05930038
                   Until Ind-Spes        >     W-Max-Spes-Tab           05940038
                   Or    W-Spes-Dato (Ind-Spes)                         05950038
                                         =     +0                       05960038
                   Or    W-Spes-Dato (Ind-Spes)                         05970038
                                         =     W-Current-Dato           05980038
      *                                                                 05990038
           End-Perform                                                  06000038
      *                                                                 06010038
           If  Ind-Spes                  >     W-Max-Spes-Tab           06020038
           or  W-Spes-Dato (Ind-Spes)    =     +0                       06030038
             Then                                                       06040038
               Continue                                                 06050038
             Else                                                       06060038
               Move  W-Spes-Type (Ind-Spes)                             06070038
                                         To    W-Dag-Type               06080038
               If  Not Sw-Spes-Ikke-Helligdag (Ind-Spes)                06090038
                   Set   SW-Fridag       To    True                     06100038
               End-If                                                   06110038
           End-If                                                       06120038
      *                                                                 06130038
           .                                                            06140038
       F099-Exit.                                                       06150038
           Exit.                                                        06160038
