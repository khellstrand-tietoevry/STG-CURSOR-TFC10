      *################################################################*01570099
       D100-Read-Sys-Code-Rel            Section.                       01580099
      *                                                                 01590099
           Initialize                          R115ISR0-Sys-Code-Rel    01600099
           Set   R115ISR0-Version        To    True                     01610099
           Set   R115ISR0-In-Get-1st     To    True                     01620099
           Set   R115ISR0-In-CC-Count    To    True                     01630099
      *                                                                 01640099
           Move  RTFCE100-I-Fin-Inst-No-D                               01650099
                                         To    R115ISR0-In-F-I-No       01660099
           Move  'OPERATION-TYPE'        To    R115ISR0-In-From-ST-Type 01670099
           Move  RTFCE100-I-Operation-Type-D                            01680099
                                         To    R115ISR0-In-From-SC-Code 01690099
           Move  Spaces                  To  R115ISR0-In-From-Contr-Type01700099
      *                                                                 01710099
           Move  'STATUS'                To    R115ISR0-In-To-ST-Type   01720099
           Move  '*'                     To    R115ISR0-In-To-SC-Code   01730099
           Move  Spaces                  To    R115ISR0-In-To-Contr-Type01740099
      *                                                                 01750099
           Move  'VALID-OP-ST'           To    R115ISR0-In-Relation-Type01760099
                                                                        01770099
           Call  'F115ISR0'              Using R115ISR0-Sys-Code-Rel    01780099
                                               R7919999-Error-Area      01790099
           End-Call                                                     01800099
      *                                                                 01810099
           Evaluate True                                                01820099
             When R7919999-Return-Abend                                 01830099
               Move  'D101'              To    R7919999-Paragraph       01840099
               Move  'FM'                To    R400CH01-Message-Code    01850099
               Perform Z900-Abend                                       01860099
      *                                                                 01870099
             When R7919999-Return-Error                                 01880099
               Move  'D102'              To    R7919999-Paragraph       01890099
               Move  'FM'                To    R400CH01-Message-Code    01900099
               Perform Z700-Error-AE                                    01910099
      *                                                                 01920099
             When R115ISR0-Out-Total-Rows > 1                           01930099
               Move  'VAR1'              To    R400CH01-Message-Key(1)  01940099
               Move  RTFCE100-I-Operation-Type-D                        01950099
                                         To    R400CH01-Message-Data(1) 01960099
               Move  'TF-SY-STATUS-NOT-UNIQUE'                          01970099
                                         To    R400CH01-Message-Code    01980099
               Perform Z700-Error-AE                                    01990099
           End-Evaluate                                                 02000099
      *                                                                 02010099
           .                                                            02020099
      *                                                                 02030099
       D100-Read-Sys-Code-Rel-Ex.                                       02040099
           Exit.                                                        02050099
      *################################################################*02060099
       D200-Read-Timestamp               Section.                       02070099
      *                                                                 02080099
           Initialize                          R7919070-Timestamp       02090099
           Set   R7919070-Versjon        To    True                     02100099
      *                                                                 02110099
           Call  'F7919070'              Using R7919070-Timestamp       02120099
                                               R7919999-Error           02130099
           End-Call                                                     02140099
      *                                                                 02150099
           If  Not R7919999-Retur-OK                                    02160099
               Move  'D201'              To    R7919999-Paragraf        02170099
               Perform Z900-Abend                                       02180099
           End-If                                                       02190099
      *                                                                 02200099
      *    Move  R7919070-Ut-Timestamp   To    &ååååmmddttmmsshh        02210099
      *                                                                 02220099
      *    Convert R7919070-Ut-Timestamp to DB2-Timestamp format.       02230099
      *                                                                 02240099
           Initialize                          R7919270-Konv-Timestamp  02250099
           Set   R7919270-Versjon        To    True                     02260099
      *                                                                 02270099
           Move  R7919070-Ut-Timestamp   To    R7919270-In-Timestamp    02280099
      *                                                                 02290099
           Call  'F7919270'              Using R7919270-Konv-Timestamp  02300099
                                               R7919999-Error           02310099
           End-Call                                                     02320099
      *                                                                 02330099
           If  Not R7919999-Retur-OK                                    02340099
               Move  'D202'              To    R7919999-Paragraf        02350099
               Perform Z900-Abend                                       02360099
           End-If                                                       02370099
      *                                                                 02380099
      *    Move  R7919270-Ut-Timestamp-DB2                              02390099
      *                                                                 02400099
           .                                                            02410099
      *                                                                 02420099
       D200-Read-Timestamp-Ex.                                          02430099
           Exit.                                                        02440099
      *                                                                 02442099
           .                                                            02443099
      *----------------------------------------------------------------*02443199
       D300-Set-Indicators               Section.                       02443299
      *                                                                 02444099
      *                                                                 02444299
           If  RTFCE100-I-Due-Date-I     = 'U'           And            02444399
               RTFCE100-I-Tenor-I        = 'U'           And            02444499
      *        RTFCE100-I-Operation-Type-D = 'ISSUE-GAR' And            02444599
               RTFCE100-I-Contract-Type-D  = 'ILG'                      02444699
               Set TF-Aut-Prov           To True                        02444799
           Else                                                         02445299
               Set TF-Aut-Prov-Not       To True                        02445399
           End-if                                                       02445499
           .                                                            02445599
       D300-Set-Indicators-Ex.                                          02445699
           Exit.                                                        02446099
