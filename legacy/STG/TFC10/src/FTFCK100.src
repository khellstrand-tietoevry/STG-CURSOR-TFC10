                    Move 'Utløpssted'                                   09800000
                                     To  R400CH01-Message-Data(1)       09810000
      *                                                                 09820000
                 When RTFCE100-I-Confirmed-I         =  'U'             09830000
                    Move 'F'         To  RTFCE100-I-Confirmed-O         09840000
                    Move 'Bekreftet/ubekreftet'                         09850000
                                     To  R400CH01-Message-Data(1)       09860000
      *                                                                 09870000
                 When RTFCE100-I-Max-Pst-Tolerance-I =  'U'             09880000
                    Move 'F'         To  RTFCE100-I-Max-Pst-Tolerance-O 09890000
                    Move 'Max. toleranse'                               09900000
                                     To  R400CH01-Message-Data(1)       09910000
      *                                                                 09920000
                 When RTFCE100-I-Min-Pst-Tolerance-I =  'U'             09930000
                    Move 'F'         To  RTFCE100-I-Min-Pst-Tolerance-O 09940000
                    Move 'Min. toleranse'                               09950000
                                     To  R400CH01-Message-Data(1)       09960000
      *                                                                 09970000
                End-Evaluate                                            09980000
      *                                                                 09990000
                Move  'TF-SY-FIELD-DEP-FELT1-FELT2'                     10000000
                                         To    R400CH01-Message-Code    10010000
                Move  'VAR1'             To    R400CH01-Message-Key(1)  10020000
                Move  'VAR2'             To    R400CH01-Message-Key(2)  10030000
                Move  'Inkasso'          To    R400CH01-Message-Data(2) 10040000
                Perform Z700-Error-AE                                   10050000
           End-If                                                       10060000
      *                                                                 10070000
      * ADVICE and ISSUE. Fields that are not valid.                    10080000
      *                                                                 10090000
           If (   RTFCE100-I-Operation-Type-D = 'ADVICE              '  10100000
               Or RTFCE100-I-Operation-Type-D = 'ISSUE               ') 10110000
           And RTFCE100-I-Follow-Up-Date-I  = 'U'                       10120000
               Move  'F'                 To  RTFCE100-I-Follow-Up-Date-O10130000
               Move  'TF-SY-FIELD-DEP-FELT1-FELT2'                      10140000
                                         To    R400CH01-Message-Code    10150000
               Move  'VAR1'              To    R400CH01-Message-Key(1)  10160000
               Move  'Oppfølgningsdato'  To    R400CH01-Message-Data(1) 10170000
               Move  'VAR2'              To    R400CH01-Message-Key(2)  10180000
               Move  'Remburs'           To    R400CH01-Message-Data(2) 10190000
               Perform Z700-Error-AE                                    10200000
           End-If                                                       10210000
      *                                                                 10220000
           If  RTFCE100-I-Operation-Type-D = 'ISSUE'                    10230000
           And RTFCE100-I-Silent-Confr-I  = 'U'                         10240000
               Move  'F'                 To  RTFCE100-I-Silent-Confr-O  10250000
               Move  'TF-SY-FIELD-DEP-FELT1-FELT2'                      10260000
                                         To    R400CH01-Message-Code    10270000
               Move  'VAR1'              To    R400CH01-Message-Key(1)  10280000
               Move  'Silent Confirmation'                              10290000
                                         To    R400CH01-Message-Data(1) 10300000
               Move  'VAR2'              To    R400CH01-Message-Key(2)  10310000
               Move  'Import remburs'    To    R400CH01-Message-Data(2) 10320000
               Perform Z700-Error-AE                                    10330000
           End-If                                                       10340000
      *                                                                 10350000
           If  RTFCE100-I-Operation-Type-D = 'ADVICE'                   10360000
           And RTFCE100-I-Contract-Type-D  = 'ECC'                      10370000
           And RTFCE100-I-Silent-Confr-I   = 'U'                        10380000
           And RTFCE100-I-Silent-Confr-D   = 'Y'                        10390000
               Move  'F'                 To  RTFCE100-I-Silent-Confr-O  10400000
               Move  'GL-FELT2-IKKE-UTF-FELT1='                         10410000
                                         To    R400CH01-Message-Code    10420000
               Move  'FELT1'             To    R400CH01-Message-Key(1)  10430000
               Move  'Kontraktstype'     To    R400CH01-Message-Data(1) 10440000
               Move  'FELT2'             To    R400CH01-Message-Key(2)  10450000
               Move  'Silent Confirmation'                              10460000
                                         TO    R400CH01-Message-Data(2) 10470000
               Move  'FELT3'             To    R400CH01-Message-Key(3)  10480000
               Move  'ECC'               TO    R400CH01-Message-Data(3) 10490000
               Perform Z700-Error-AE                                    10500000
           End-If                                                       10510000
      *                                                                 10520000
      *  Is Contract-Type valid at given Operation-Type.                10530000
      *                                                                 10540000
           Initialize                          R115ISR0-Sys-Code-Rel    10550000
           Set   R115ISR0-Version        To    True                     10560000
           Set   R115ISR0-In-Select      To    True                     10570000
           Set   R115ISR0-In-CC-Count    To    True                     10580000
      *                                                                 10590000
           Move  RTFCE100-I-Fin-Inst-No-D                               10600000
                                         To    R115ISR0-In-F-I-No       10610000
           Move  'CONTRACT-TYPE'         To    R115ISR0-In-From-ST-Type 10620000
           Move  RTFCE100-I-Contract-Type-D                             10630000
                                         To    R115ISR0-In-From-SC-Code 10640000
           Move  Spaces                  To  R115ISR0-In-From-Contr-Type10650000
      *                                                                 10660000
           Move  'OPERATION-TYPE'        To    R115ISR0-In-To-ST-Type   10670000
           Move  RTFCE100-I-Operation-Type-D                            10680000
                                         To    R115ISR0-In-To-SC-Code   10690000
           Move  Spaces                  To    R115ISR0-In-To-Contr-Type10700000
      *                                                                 10710000
           Move  'VALID-CT-OP'           To    R115ISR0-In-Relation-Type10720000
                                                                        10730000
           Call  'F115ISR0'              Using R115ISR0-Sys-Code-Rel    10740000
                                               R7919999-Error-Area      10750000
           End-Call                                                     10760000
      *                                                                 10770000
           Evaluate True                                                10780000
             When R7919999-Return-Abend                                 10790000
               Move  'C521'              To    R7919999-Paragraph       10800000
               Move  'FM'                To    R400CH01-Message-Code    10810000
               Perform Z900-Abend                                       10820000
                                                                        10830000
             When R7919999-Return-Error                                 10840000
               Move 'F'                  To   RTFCE100-I-Contract-Type-O10850000
               Move  RTFCE100-I-Contract-Type-D                         10860000
                                         To    R400CH01-Message-Data(1) 10870000
               Move 'VAR1'               To    R400CH01-Message-Key(1)  10880000
               Move  RTFCE100-I-Operation-Type-D                        10890000
                                         To    R400CH01-Message-Data(2) 10900000
               Move 'VAR2'               To    R400CH01-Message-Key(2)  10910000
               Move 'TF-SY-INVALID-CONTR-OPERTYP'                       10920000
                                         To    R400CH01-Message-Code    10930000
               Perform Z700-Error-AE                                    10940000
           End-Evaluate                                                 10950000
      *                                                                 10960000
      * Check the format of TENOR                                       10970000
      *                                                                 10980000
           If   RTFCE100-I-Tenor-I       = 'U'                          10990000
            and RTFCE100-I-Tenor-D  Not  =  Spaces                      11000000
      *                                                                 11010000
              If   RTFCE100-I-Contract-Type-D  = 'ILG '                 11011013
                If RTFCE100-I-Tenor-D  =                                11011110
                   ('  ' or 'KVT' or 'MND' or 'HLV' or 'AAR')           11011210
                   Continue                                             11011310
                Else                                                    11011410
                   Initialize                  R7918030-ErrorMessage    11011510
                   Move  'TF-SY-EI-TENOR-ERR'                           11011610
                                         To    R7918030-In-MessageCode  11011710
      *                                                                 11011810
                   Perform Z000-Error-Message                           11011910
      *                                                                 11012010
                   Move  'E523'          To    R7919999-Paragraph       11012110
                   Move  'FM'            To    R400CH01-Message-Code    11012210
                   Perform Z700-Error-AE                                11012310
                End-If                                                  11012410
              Else                                                      11013010
                Move RTFCE100-I-Tenor-D  To    Ws-Tenor                 11020000
      *                                                                 11030000
      *   1 pos has to be D or M                                        11040000
      *                                                                 11050000
                If   Ws-Tenor-DM     Not =    'D' And 'd'               11060000
                 and Ws-Tenor-DM     Not =    'M' And 'm'               11070000
      *                                                                 11080000
                   Initialize                  R7918030-ErrorMessage    11090000
                   Move  'TF-SY-EI-TENOR-ERR'                           11100000
                                         To    R7918030-In-MessageCode  11110000
      *                                                                 11120000
                   Perform Z000-Error-Message                           11130000
      *                                                                 11140000
                   Move  'E524'          To    R7919999-Paragraph       11150010
                   Move  'FM'            To    R400CH01-Message-Code    11160000
                   Perform Z700-Error-AE                                11170000
                End-If                                                  11180000
      *                                                                 11190000
      *   2,3 and 4 pos have to be a numeric value                      11200000
      *                                                                 11210000
                If  Ws-Tenor-No-Of-DM    Not   Numeric                  11220000
                   Initialize                  R7918030-ErrorMessage    11230000
                   Move  'TF-SY-EI-TENOR-ERR'                           11240000
                                         To    R7918030-In-MessageCode  11250000
      *                                                                 11260000
                   Perform Z000-Error-Message                           11270000
      *                                                                 11280000
                   Move  'E525'          To    R7919999-Paragraph       11290010
                   Move  'FM'            To    R400CH01-Message-Code    11300000
                   Perform Z700-Error-AE                                11310000
                End-If                                                  11320000
      *                                                                 11330000
      *   5 and 6 pos have to be a specific code                        11340000
      *                                                                 11350000
                If  Ws-Tenor-Code      Not = 'BE' And 'CC' And 'FD' And 11360000
                                             'FP' And 'GA' And 'ID' And 11370000
                                             'ST' And 'TD' And 'XX' And 11380000
                                             'be' And 'cc' And 'fd' And 11390000
                                             'fp' And 'ga' And 'id' And 11400000
                                             'st' And 'td' And 'xx'     11410000
                  Initialize                  R7918030-ErrorMessage     11420000
                  Move  'TF-SY-EI-TENOR-ERR'                            11430000
                                        To    R7918030-In-MessageCode   11440000
      *                                                                 11450000
                  Perform Z000-Error-Message                            11460000
      *                                                                 11470000
                  Move  'E526'          To    R7919999-Paragraph        11480010
                  Move  'FM'            To    R400CH01-Message-Code     11490000
                  Perform Z700-Error-AE                                 11500000
                End-If                                                  11510000
      *                                                                 11520000
              End-If                                                    11530010
           End-If                                                       11531010
      *                                                                 11540000
           If  RTFCE100-I-Due-Date-I     =     'U'                      11541009
           And RTFCE100-I-Tenor-I        =     'U'                      11542009
           And RTFCE100-I-Contract-Type-D  Not = 'ILG '                 11542114
               Move  'F'                 To    RTFCE100-I-Due-Date-O    11543009
               Move  'FELT1'             To    R400CH01-Message-Key(1)  11544009
               Move  'Forfallsdato'      To    R400CH01-Message-Data(1) 11545009
               Move  'FELT2'             To    R400CH01-Message-Key(2)  11546009
               Move  'Forfallstid'       To    R400CH01-Message-Data(2) 11547009
               Move  'TF-SY-FIELD1-NOT-FIELD2'                          11548009
                                         To    R400CH01-Message-Code    11549009
               Perform  Z700-Error-AE                                   11549109
           End-If                                                       11549209
      *                                                                 11540000
           If  (RTFCE100-I-Due-Date-I     =     'U')       And          11541009
             (  RTFCE100-I-Due-Date-D     Not = 99991231 ) And          11541009
             (  RTFCE100-I-Expiry-Date-I  =     'U' )      And                  
             (  RTFCE100-I-Due-Date-D     Not <                                 
               RTFCE100-I-Expiry-Date-D )                                       
               Move  'GL-UGYLDIG-DATO'                                  11548009
                                         To    R400CH01-Message-Code    11549009
               Perform  Z700-Error-AE                                   11549109
           End-If                                                       11549209
      *                                                                 11549309
           .                                                            11551000
      *<META C520-DEPENDENCIES-UA-EX>                                   11560000
       C520-Dependencies-UA-Ex.                                         11570000
           Exit.                                                        11580000
      *</META>                                                          11590000
