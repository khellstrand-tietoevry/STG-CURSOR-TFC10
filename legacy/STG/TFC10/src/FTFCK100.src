      *################################################################*11852000
      * Check dependencies against databas fields.                     *11860000
      *                                                                *11870000
      * Here we perform all nesecarry control , before return to the   *11880000
      * H-module.                                                      *11890000
      *                                                                *11900000
      * Add Perform statements to other sections that contain the      *11910000
      * actual controls.                                               *11920000
      *----------------------------------------------------------------*11930000
      *<META E000-CONTROL-BASE>                                         11940000
       E000-Control-Base                 Section.                       11950000
      *                                                                 11960000
      *</META>                                                          11970000
      *                                                                 11980000
           If  RTFCE100-B-Contract-No-I = 'U'                           11990000
               Perform E100-Check-Status                                12000000
           End-If                                                       12010000
      *                                                                 12020000
           If   RTFCE100-I-Contract-Type-D  = 'ILG '     And            12021011
                RTFCE100-I-Due-Date-I = 'U'              And            12022011
                RTFCE100-I-Tenor-I    = 'U'                             12023011
                Perform E200-product-Check                              12024011
           End-if                                                       12025011
           .                                                            12030000
      *                                                                 12040000
      *<META E000-CONTROL-BASE-EX>                                      12050000
       E000-Control-Base-Ex.                                            12060000
           Exit.                                                        12070000
      *</META>                                                          12080000
                                                                        12090000
      *################################################################*12100000
       E100-Check-Status                 Section.                       12110000
      *                                                                 12120000
           Initialize                          R115L050-Initial-Check   12130000
           Set   R115L050-Version        To    True                     12140000
      *                                                                 12150000
           Move  R400CH01-Function       To    R115L050-Function        12160000
           Move  R400CH01-Medium         To    R115L050-Medium          12170000
           Move  RTFCE100-I-Fin-Inst-No-D                               12180000
                                         To    R115L050-Fin-Inst-No     12190000
           Move  RTFCE100-I-Contract-Type-D                             12200000
                                         To    R115L050-Contr-Type      12210000
           Move  RTFCE100-B-Contract-No-D                               12220000
                                         To    R115L050-Contr-No        12230000
           Move  RTFCE100-I-Operation-Type-D                            12240000
                                         To    R115L050-Operation-Type  12250000
           Move  RTFCE100-B-Last-Saved-Date-D                           12260000
                                         To    R115L050-Last-Update-TX  12270000
           Set   R115L050-Check-For-Upd-Yes                             12280000
                                         To    True                     12290000
      *                                                                 12300000
           Call  'F115L050'              Using R115L050-Initial-Check   12310000
                                               R7919999-Error           12320000
           End-Call                                                     12330000
      *                                                                 12340000
           Evaluate True                                                12350000
             When R7919999-Return-Abend                                 12360000
                                                                        12370000
               Move  'E101'              To    R7919999-Paragraph       12380000
               Move  'FM'                To    R400CH01-Message-Code    12390000
               Perform Z900-Abend                                       12400000
                                                                        12410000
             When R7919999-Return-Error                                 12420000
               Move  'E102'              To    R7919999-Paragraph       12430000
               Move  'FM'                To    R400CH01-Message-Code    12440000
               Perform Z700-Error-AE                                    12450000
                                                                        12460000
             When R7919999-Return-OK                                    12470000
               Continue                                                 12480000
           End-Evaluate                                                 12490000
      *                                                                 12500000
           .                                                            12510000
      *                                                                 12520000
       E100-Check-Status-Ex.                                            12530000
           Exit.                                                        12540000
      *                                                                 12540111
       E200-product-Check                Section.                       12541011
           Initialize                    R115ISC0-Sys-Code              12542011
                                                                        12543011
           Set   R115ISC0-Version        To    True                     12544011
           Set   R115ISC0-In-Select      To    True                     12545011
      *                                                                 12546011
           Move  RTFCE100-I-Fin-Inst-No-D                               12547013
                                         To    R115ISC0-In-Fin-Inst-No  12548011
           Move  'PRODUCT-AVAIL '        To    R115ISC0-In-ST-Type      12549011
           Move  'PROV-DT-TF'            To    R115ISC0-In-SC-Code      12549115
      *                                                                 12549211
           Call  'F115ISC0'              Using R115ISC0-Sys-Code        12549311
                                               R7919999-Error-Area      12549411
           End-Call                                                     12549511
      *                                                                 12549611
           Evaluate True                                                12549711
             When R7919999-Return-Abend                                 12549811
               Move  'E201'              To    R7919999-Paragraph       12549911
               Move  'FM'                To    R400CH01-Message-Code    12550011
               Perform Z900-Abend                                       12550111
                                                                        12550211
             When R7919999-Return-Error                                 12550311
               Move  'F'                 To   RTFCE100-I-Due-Date-O     12550512
               Move  'SY-IKKE-TILG-FUNK' To R400CH01-Message-Code       12551112
               Perform  Z700-Error-AE                                   12551212
                                                                        12551312
             When R7919999-Return-OK                                    12551412
               If  RTFCE100-I-Due-Date-I     =     'U'                  11541009
               And RTFCE100-I-Tenor-I        =     'U'                  11542009
                 Continue                                               12551512
               Else                                                             
                 Move  'F'               To    RTFCE100-I-Due-Date-O    11543009
                 Move  'FELT1'           To    R400CH01-Message-Key(1)  11544009
                 Move  'Forfallsdato'    To    R400CH01-Message-Data(1) 11545009
                 Move  'FELT2'           To    R400CH01-Message-Key(2)  11546009
                 Move  'Forfallstid'     To    R400CH01-Message-Data(2) 11547009
                 Move  'TF-SY-FIELD1-AND-FIELD2'                        11548009
                                         To    R400CH01-Message-Code    11549009
                 Perform  Z700-Error-AE                                 11549109
               End-If                                                           
                                                                        12551612
           End-Evaluate                                                 12551712
           .                                                            12551812
      *################################################################*12552000
       Z000-Error-Message                Section.                       12560000
      *                                                                 12570000
           Set   R7918030-Version        To    True                     12580000
      *                                                                 12590000
           Move  'TF'                    To    R7918030-In-System-ID    12600000
           Move  R115X000-Fin-Inst-No    To    R7918030-In-Fin-Inst-No  12610000
           Move  R115X000-FI-Language-639-1                             12620000
                                         To    R7918030-In-Language     12630000
      *                                                                 12640000
           If  R115X000-Trace-On                                        12650000
               Set  R7918030-In-Log-Yes  To    True                     12660000
           End-If                                                       12670000
      *                                                                 12680000
           Call  'F7918030'              Using R7918030-ErrorMessage    12690000
           End-Call                                                     12700000
      *                                                                 12710000
           Move  R7918030-Out-MessageText                               12720000
                                         To    R7919999-Message         12730000
      *                                                                 12740000
           .                                                            12750000
      *################################################################*12760000
       Z600-Error-AW                     Section.                       12770000
      *                                                                 12780000
           Set   R7919999-Return-Warning To    True                     12790000
           Move  'FTFCK100'              To    R400CH01-Message-Text    12800000
           .                                                            12810000
      *                                                                 12820000
       Z600-Error-AW-Ex.                                                12830000
           Exit.                                                        12840000
      *</META>                                                          12850000
                                                                        12860000
      *################################################################*12870000
      * Syntax Error status                                            *12880000
      *                                                                *12890000
      *----------------------------------------------------------------*12900000
      *<META Z700-ERROR-AE>                                             12910000
       Z700-Error-AE                     Section.                       12920000
      *                                                                 12930000
           Set   R7919999-Return-Error   To    True                     12940000
           If    R400CH01-Message-Code   =     'FM'                     12950000
                 String   'FTFCK100'           Delimited By Size        12960000
                          ': '                 Delimited By Size        12970000
                       R7919999-Message        Delimited By Size        12980000
                                         Into  R400CH01-Message-Text    12990000
                 End-String                                             13000000
           Else                                                         13010000
                 Move  'FTFCK100'        To    R400CH01-Message-Text    13020000
           End-If                                                       13030000
           .                                                            13040000
      *                                                                 13050000
       Z700-Error-AE-Ex.                                                13060000
           Goback.                                                      13070000
      *</META>                                                          13080000
                                                                        13090000
      *################################################################*13100000
      * Severe error. Will genereate USER-ABEND in STG when the        *13110000
      * function is executed in batch.                                 *13120000
      *----------------------------------------------------------------*13130000
      *<META Z800-ERROR-AS>                                             13140000
       Z800-Error-AS                     Section.                       13150000
      *                                                                 13160000
           Set   R7919999-Return-Abend   To    True                     13170000
           If    R400CH01-Message-Code   =     'FM'                     13180000
                 String   'FTFCK100'           Delimited By Size        13190000
                          ': '                 Delimited By Size        13200000
                       R7919999-Message        Delimited By Size        13210000
                                         Into  R400CH01-Message-Text    13220000
                 End-String                                             13230000
           Else                                                         13240000
                 Move  'FTFCK100'        To    R400CH01-Message-Text    13250000
           End-If                                                       13260000
           .                                                            13270000
      *                                                                 13280000
       Z800-Error-AS-Ex.                                                13290000
           Goback.                                                      13300000
      *</META>                                                          13310000
                                                                        13320000
      *################################################################*13330000
      * Severe error. Will genereate USER-ABEND in STG when the        *13340000
      * function is executed in batch.                                 *13350000
      *----------------------------------------------------------------*13360000
      *<META Z900-ABEND>                                                13370000
       Z900-Abend                        Section.                       13380000
      *                                                                 13390000
           Set   R7919999-Return-Abend   To    True                     13400000
           If    R400CH01-Message-Code   =     'FM'                     13410000
                 String   'FTFCK100'           Delimited By Size        13420000
                          ': '                 Delimited By Size        13430000
                       R7919999-Message        Delimited By Size        13440000
                                         Into  R400CH01-Message-Text    13450000
                 End-String                                             13460000
           Else                                                         13470000
                 Move  'FTFCK100'        To    R400CH01-Message-Text    13480000
           End-If                                                       13490000
      *                                                                 13500000
      *----------------------------------------------------------------*13510000
      *                                                                 13520000
           If  R7919999-Return-Code      Not   Numeric                  13530000
           or  Not R7919999-Return-Abend                                13540000
               Move  +0                  To    R7919999-Module-Ind      13550000
           End-If                                                       13560000
           Add   +1                      To    R7919999-Module-Ind      13570000
           If  R7919999-Module-Ind       Not >                          13580000
                             ( Length    Of    R7919999-Module-Tab      13590000
                             / Length    Of    R7919999-Module-Element )13600000
               Move  'FTFCK100'          To    R7919999-Module-Name     13610000
                                               (R7919999-Module-Ind)    13620000
               Move  R7919999-Paragraph  To    R7919999-Module-Para     13630000
                                               (R7919999-Module-Ind)    13640000
           End-If                                                       13650000
           Set   R7919999-Return-Abend   To    True                     13660000
           .                                                            13670000
      *                                                                 13680000
       Z900-Abend-Ex.                                                   13690000
           Goback.                                                      13700000
      *</META>                                                          13710000
      *                                                                 13720000
       End Program FTFCK100.                                            13730000
